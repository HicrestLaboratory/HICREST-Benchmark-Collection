            "tickFormatter": "def format_bytes(size_bytes, binary=False, precision=2, space_between_size_and_unit=False):\n    \"\"\"\n    Convert a size in bytes into a human-readable string.\n\n    Args:\n        size_bytes (int or float): Size in bytes\n        binary (bool): If True, use binary units (KiB, MiB, GiB).\n                        If False, use SI units (KB, MB, GB)\n        precision (int): Number of decimal places\n\n    Returns:\n        str: Human-readable string\n    \"\"\"\n    if size_bytes < 0:\n        # raise ValueError(f\"size_bytes must be non-negative: got {size_bytes}\")\n        return size_bytes\n\n    if binary:\n        # Binary prefixes: 1024\n        units = [\"B\", \"KiB\", \"MiB\", \"GiB\", \"TiB\", \"PiB\"]\n        factor = 1024.0\n    else:\n        # SI prefixes: 1000\n        units = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\"]\n        factor = 1000.0\n\n    size = float(size_bytes)\n    for unit in units:\n        if size < factor:\n            return f\"{size:.{precision}f}{' ' if space_between_size_and_unit else ''}{unit}\"\n        size /= factor\n\n    return f\"{size:.{precision}f}{' ' if space_between_size_and_unit else ''}{units[-1]}\"\n\ndef format_tick(value, axis):\n    if axis == 'y' and value > 0:\n        return value\n    return format_bytes(value, precision=0)\n",
