#!/bin/bash

set -e

algorithms="MCS SpinLock HemLock PthreadLock Reciprocating FissileTicket"
time=60

rawhost=$(hostname)

mkdir -p "${rawhost}"

if [ $# -gt 0 ]; then
    algorithms="$@"
fi

rm -f core

for algorithm in ${algorithms}; do
    exe="${algorithm}.out"
    outfile="${rawhost}/${algorithm}"

    if [ ! -x "${exe}" ]; then
        echo "Executable ${exe} not found."
        echo "Run ./compile.sh first."
        exit 1
    fi

    if [ "${LOCKS_ENABLE_PERF}" = "1" ]; then
        outfile="${rawhost}/${algorithm}_cache"
    fi

    echo "Running ${algorithm}..."

    ./run1 time=${time} exec="./${exe}" | tee "${outfile}"

    if [ -f core ]; then
        echo "Core dump generated for ${algorithm}"
        break
    fi
done
